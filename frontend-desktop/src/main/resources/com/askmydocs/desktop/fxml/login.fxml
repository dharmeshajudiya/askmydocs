<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.askmydocs.desktop.controller.LoginController"
      styleClass="root-pane"
      alignment="CENTER" spacing="0">

    <!-- Header -->
    <VBox alignment="CENTER" spacing="8" styleClass="login-header">
        <Label text="AskMyDocs" styleClass="app-title"/>
        <Label text="Upload documents. Ask questions. Get answers." styleClass="app-subtitle"/>
    </VBox>

    <!-- Card -->
    <VBox styleClass="login-card" spacing="16" maxWidth="360">

        <!-- Tab toggle -->
        <HBox spacing="8" styleClass="tab-bar">
            <Button fx:id="btnLoginTab"    text="Sign In"    onAction="#switchToLogin"
                    styleClass="tab-btn,tab-active" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRegisterTab" text="Register"   onAction="#switchToRegister"
                    styleClass="tab-btn"            maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Email -->
        <VBox spacing="6">
            <Label text="Email" styleClass="field-label"/>
            <TextField fx:id="emailField" promptText="you@example.com" styleClass="input-field"/>
        </VBox>

        <!-- Password -->
        <VBox spacing="6">
            <Label text="Password" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="input-field"/>
        </VBox>

        <!-- Error -->
        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" managed="false" visible="false"/>

        <!-- Submit -->
        <Button fx:id="submitBtn" text="Sign In" onAction="#handleSubmit"
                styleClass="primary-btn" maxWidth="Infinity"/>

    </VBox>
</VBox>
